# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time; redeploy after changing them.

# Canonical site URL (no trailing slash). Falls back to the Vercel production URL, then localhost.
NEXT_PUBLIC_SITE_URL=https://capitiro.com

# Real, monitored inbox shown on Contact / Privacy / Terms.
NEXT_PUBLIC_CONTACT_EMAIL=hello@capitiro.com

# Google AdSense publisher id. Leave empty until you apply; enables the ad script, verification meta tag and ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Display ad unit slot id for in-content ads (create after approval). Optional with Auto ads.
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=

# Microsoft Clarity project id (heatmaps/recordings). Defaults to Capitiro's id; set empty to disable.
NEXT_PUBLIC_CLARITY_ID=yvn44sv5s0
